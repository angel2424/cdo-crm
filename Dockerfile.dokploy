# ========================================================
# Stage 1: Build Frontend Assets & PHP Dependencies
# ========================================================
FROM php:8.4-cli-bookworm AS builder

# Install official PHP extension installer helper (fast pre-built binaries)
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

# Install required PHP extensions for builder validation & composer
RUN install-php-extensions xml exif pdo_mysql gettext iconv mysqli zip bcmath gd

# Install system dependencies (git, unzip for composer)
RUN apt-get update && apt-get install -y git unzip curl make python3 && rm -rf /var/lib/apt/lists/*

# Install official Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
ENV COMPOSER_MEMORY_LIMIT=-1

# Install Node.js 24 (aligned with package.json engines >=24.0.0)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cache package dependencies
COPY package*.json ./
RUN npm install --no-audit --no-fund

# Copy repository source files
COPY . .

# Build frontend bundles (webpack, grunt) and PHP composer dependencies
RUN npm run build

# ========================================================
# Stage 2: Production Apache Runtime
# ========================================================
FROM php:8.4-apache-bookworm AS production

LABEL maintainer="ChurchCRM"
EXPOSE 80

# Install extension installer helper
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

# Install runtime extensions and enable Apache mod_rewrite
RUN install-php-extensions xml exif pdo_mysql gettext iconv mysqli zip gd && \
    a2enmod rewrite

# Install locales for multilingual support
RUN apt-get update && apt-get install -y locales locales-all gettext && rm -rf /var/lib/apt/lists/*

# Apache & PHP configuration
COPY docker/apache/default.conf /etc/apache2/apache2.conf
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i 's/^upload_max_filesize.*$/upload_max_filesize = 25M/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^post_max_size.*$/post_max_size = 30M/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^memory_limit.*$/memory_limit = 512M/g' $PHP_INI_DIR/php.ini && \
    sed -i 's/^max_execution_time.*$/max_execution_time = 120/g' $PHP_INI_DIR/php.ini

WORKDIR /var/www/html

# Copy built application from builder stage
COPY --from=builder /app/src /var/www/html

# Copy entrypoint script
COPY docker/dokploy-entrypoint.sh /usr/local/bin/dokploy-entrypoint.sh
RUN chmod +x /usr/local/bin/dokploy-entrypoint.sh

# Set ownership for Apache
RUN chown -R www-data:www-data /var/www/html

ENTRYPOINT ["/usr/local/bin/dokploy-entrypoint.sh"]
CMD ["apache2-foreground"]
