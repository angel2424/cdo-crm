# ==============================================================================
# ChurchCRM Dokploy Environment Variables
# ==============================================================================
# Copy these values into the "Environment" tab of your Dokploy Compose service.

# Database Passwords (MUST CHANGE BEFORE DEPLOYING!)
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword123!
MYSQL_PASSWORD=ChangeThisUserPassword123!

# Application Access URL
# IMPORTANT: Must include protocol (https://) and MUST end with a trailing slash!
# Example: https://crm.yourdomain.com/
CRM_URL=https://crm.yourdomain.com/

# Optional host port mapping if bypassing Traefik directly
APP_PORT=8080
